# ─── Smart-speaker secrets ──────────────────────────────────────────────────
# Copy this file to ".env" and paste your real keys. ".env" is gitignored, so
# your keys never get committed. A real shell environment variable still wins
# over .env (load_dotenv does not override variables already set in the shell).

# Google AI Studio key — FREE tier, no billing required.
# Get one at: https://aistudio.google.com/app/apikey
# Used by main.py (Live) and main_local.py (free pipeline).
GEMINI_API_KEY=your-google-ai-studio-key

# Anthropic key — paid. Used by main_claude.py only.
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-key

# ─── Optional overrides (uncomment to change defaults) ──────────────────────
# CLAUDE_MODEL=claude-haiku-4-5
# BRIEF_USER_NAME=Lubo
# BRIEF_LOCATION_NAME=Bratislava
# BRIEF_LATITUDE=48.1486
# BRIEF_LONGITUDE=17.1077
# BRIEF_NEWS_FEED=https://www.sme.sk/rss
